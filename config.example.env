# Demo settings. Copy this file to config.env (git-ignored) and edit it:
#   cp config.example.env config.env
# Lines are KEY="value"; environment variables override them. Everything except OCTOPUS_URL
# has a default, so you can delete any line you don't need to change.

# --- Octopus ---------------------------------------------------------------------------
# Your Octopus Server, e.g. https://your-instance.octopus.app (no trailing /api).
OCTOPUS_URL="https://your-instance.octopus.app"

# A file containing an Octopus API key (just the key). Relative paths are from the repo root;
# secrets/ is git-ignored. Recommended: the key (an AI agent key is fine) of a service account
# that's a space manager of OCTOPUS_SPACE_NAME, created for it by an administrator. The demo
# uses this one key for everything; production setups should use separate, tightly scoped
# keys. See "The Octopus API key" in README.md.
OCTOPUS_API_KEY_FILE="secrets/octopus-api-key.txt"

# The demo's space: its exact name. Normally an administrator creates it first, with the API
# key's account as a space manager. The installer creates it only if no space has this name
# and the key can create spaces (SpaceCreate). Missing environments are added.
OCTOPUS_SPACE_NAME="Argo Rollouts Demo"
OCTOPUS_ENVIRONMENTS="Development,Staging,Production"
OCTOPUS_DEMO_ENVIRONMENT="Development"

# Worker pool for the runbooks. Empty: "Hosted Ubuntu" (Octopus Cloud) if the space has it,
# otherwise the space's default worker pool. The workers need PowerShell and HTTPS access to
# OCTOPUS_URL.
OCTOPUS_WORKER_POOL=""

# Agent connection. Defaults: https://polling.<host>/ for Octopus Cloud, https://<host>:10943/
# for a self-hosted server, and grpc://<host>:8443 for the Kubernetes monitor.
OCTOPUS_POLLING_URL=""
OCTOPUS_GRPC_URL=""
KUBERNETES_MONITOR="true"

# --- Local cluster ---------------------------------------------------------------------
# kind cluster name; the agent's deployment target is AGENT_NAME (defaults to this).
CLUSTER_NAME="argo-rollouts-demo"
AGENT_NAME=""

# Host ports for the ingress: the dashboard is http://localhost:<INGRESS_HTTP_PORT>. Change them
# if 80/443 are in use (the installer checks). They're fixed when the cluster is created.
INGRESS_HTTP_PORT="80"
INGRESS_HTTPS_PORT="443"

# Where the installer puts kind, kubectl, helm and kubectl-argo-rollouts if they're missing.
BIN_DIR="~/.local/bin"
